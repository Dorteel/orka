  <rdfs:subClassOf rdf:resource="http://www.w3.org/2002/07/owl#Thing"/>
</owl:Class>

<owl:Class rdf:about="#Concept">
  <rdfs:subClassOf rdf:resource="http://www.w3.org/2002/07/owl#Thing"/>
</owl:Class>

<owl:Class rdf:about="#Instance">
  <rdfs:subClassOf rdf:resource="http://www.w3.org/2002/07/owl#Thing"/>
</owl:Class>

<owl:Class rdf:about="#ContrastClass">
  <rdfs:subClassOf rdf:resource="http://www.w3.org/2002/07/owl#Thing"/>
</owl:Class>

<owl:Class rdf:about="#Property">
  <rdfs:subClassOf rdf:resource="http://www.w3.org/2002/07/owl#Thing"/>
  <rdfs:subClassOf rdf:resource="#ConvexRegion"/>
</owl:Class>

<owl:Class rdf:about="#QualityDimension">
  <rdfs:subClassOf rdf:resource="http://www.w3.org/2002/07/owl#Thing"/>
</owl:Class>

<owl:Class rdf:about="#ConvexRegion">
  <rdfs:subClassOf rdf:resource="http://www.w3.org/2002/07/owl#Thing"/>
</owl:Class>

<owl:Class rdf:about="#MeasurementSystem">
  <rdfs:subClassOf rdf:resource="http://www.w3.org/2002/07/owl#Thing"/>
</owl:Class>

<owl:Class rdf:about="#PrototypicalInstance">
  <rdfs:subClassOf rdf:resource="#Instance"/>
</owl:Class>

<owl:Class rdf:about="#SimilaritySensitivityParameter">
  <rdfs:subClassOf rdf:resource="http://www.w3.org/2002/07/owl#Thing"/>
</owl:Class>

<owl:Class rdf:about="#Active_Sensor">
  <rdfs:subClassOf rdf:resource="#Sensor"/>
  <rdfs:subClassOf rdf:resource="http://www.w3.org/ns/sosa/Sensor"/>
  <rdfs:comment rdf:datatype="http://www.w3.org/2001/XMLSchema#string">A sensor that actively emits energy or signals to measure the environment.</rdfs:comment>
</owl:Class>

<owl:Class rdf:about="#Passive_Sensor">
  <rdfs:subClassOf rdf:resource="#Sensor"/>
  <rdfs:subClassOf rdf:resource="http://www.w3.org/ns/sosa/Sensor"/>
  <rdfs:comment rdf:datatype="http://www.w3.org/2001/XMLSchema#string">A sensor that observes naturally occurring signals without emitting energy.</rdfs:comment>
</owl:Class>

<owl:Class rdf:about="#IdentificationSensor">
  <rdfs:subClassOf rdf:resource="#Sensor"/>
  <rdfs:subClassOf rdf:resource="http://www.w3.org/ns/sosa/Sensor"/>
  <rdfs:comment rdf:datatype="http://www.w3.org/2001/XMLSchema#string">A sensor used for identifying entities, tags, or markers.</rdfs:comment>
</owl:Class>

<owl:Class rdf:about="#Exteroceptor_Sensor">
  <rdfs:subClassOf rdf:resource="#Sensor"/>
  <rdfs:subClassOf rdf:resource="http://www.w3.org/ns/sosa/Sensor"/>
  <rdfs:comment rdf:datatype="http://www.w3.org/2001/XMLSchema#string">A sensor that measures properties of the external environment.</rdfs:comment>
</owl:Class>

<owl:Class rdf:about="#Distance_Sensor">
  <rdfs:subClassOf rdf:resource="#Exteroceptor_Sensor"/>
  <rdfs:subClassOf rdf:resource="#Sensor"/>
  <rdfs:comment rdf:datatype="http://www.w3.org/2001/XMLSchema#string">A sensor that measures distance or range to external objects.</rdfs:comment>
</owl:Class>

<owl:Class rdf:about="#Light_Sensor">
  <rdfs:subClassOf rdf:resource="#Exteroceptor_Sensor"/>
  <rdfs:subClassOf rdf:resource="#Sensor"/>
  <rdfs:comment rdf:datatype="http://www.w3.org/2001/XMLSchema#string">A sensor that measures light or optical signals.</rdfs:comment>
</owl:Class>

<owl:Class rdf:about="#Speed_Sensor">
  <rdfs:subClassOf rdf:resource="#Sensor"/>
  <rdfs:subClassOf rdf:resource="http://www.w3.org/ns/sosa/Sensor"/>
  <rdfs:comment rdf:datatype="http://www.w3.org/2001/XMLSchema#string">A sensor that measures speed or velocity-related quantities.</rdfs:comment>
</owl:Class>

<owl:Class rdf:about="#Position_Sensor">
  <rdfs:subClassOf rdf:resource="#Sensor"/>
  <rdfs:subClassOf rdf:resource="http://www.w3.org/ns/sosa/Sensor"/>
  <rdfs:comment rdf:datatype="http://www.w3.org/2001/XMLSchema#string">A sensor that determines spatial position.</rdfs:comment>
</owl:Class>

<owl:Class rdf:about="#Heading_Sensor">
  <rdfs:subClassOf rdf:resource="#Passive_Sensor"/>
  <rdfs:subClassOf rdf:resource="#ProprioceptorSensor"/>
  <rdfs:subClassOf rdf:resource="#Sensor"/>
  <rdfs:comment rdf:datatype="http://www.w3.org/2001/XMLSchema#string">A sensor that measures heading or orientation.</rdfs:comment>
</owl:Class>

<owl:Class rdf:about="#Touch_Sensor">
  <rdfs:subClassOf rdf:resource="#Exteroceptor_Sensor"/>
  <rdfs:subClassOf rdf:resource="#Sensor"/>
  <rdfs:comment rdf:datatype="http://www.w3.org/2001/XMLSchema#string">A sensor that detects touch, contact, or impact.</rdfs:comment>
</owl:Class>

<owl:Class rdf:about="#Altitude_Sensor">
  <rdfs:subClassOf rdf:resource="#ProprioceptorSensor"/>
  <rdfs:subClassOf rdf:resource="#Sensor"/>
  <rdfs:comment rdf:datatype="http://www.w3.org/2001/XMLSchema#string">A sensor that measures altitude relative to a reference level.</rdfs:comment>
</owl:Class>

<owl:Class rdf:about="#Motor_Sensor">
  <rdfs:subClassOf rdf:resource="#ProprioceptorSensor"/>
  <rdfs:subClassOf rdf:resource="#Sensor"/>
  <rdfs:comment rdf:datatype="http://www.w3.org/2001/XMLSchema#string">A sensor that monitors motor or actuator state.</rdfs:comment>
</owl:Class>

<owl:Class rdf:about="#Temperature_Sensor">
  <rdfs:subClassOf rdf:resource="#ProprioceptorSensor"/>
  <rdfs:subClassOf rdf:resource="#Sensor"/>
  <rdfs:comment rdf:datatype="http://www.w3.org/2001/XMLSchema#string">A sensor measuring the temperature.</rdfs:comment>
</owl:Class>

<owl:Class rdf:about="#Pressure_Sensor">
  <rdfs:subClassOf rdf:resource="#Exteroceptor_Sensor"/>
  <rdfs:subClassOf rdf:resource="#Sensor"/>
  <rdfs:comment rdf:datatype="http://www.w3.org/2001/XMLSchema#string">A sensor measuring the temperature.</rdfs:comment>
</owl:Class>

<owl:Class rdf:about="#Humidity_Sensor">
  <rdfs:subClassOf rdf:resource="#Exteroceptor_Sensor"/>
  <rdfs:subClassOf rdf:resource="#Sensor"/>
  <rdfs:comment rdf:datatype="http://www.w3.org/2001/XMLSchema#string">A sensor measuring the temperature.</rdfs:comment>
</owl:Class>

<owl:Class rdf:about="#Camera">
  <rdfs:subClassOf rdf:resource="#Distance_Sensor"/>
  <rdfs:subClassOf rdf:resource="#IdentificationSensor"/>
  <rdfs:subClassOf rdf:resource="#Passive_Sensor"/>
  <rdfs:subClassOf rdf:resource="#Speed_Sensor"/>
  <rdfs:subClassOf rdf:resource="#Exteroceptor_Sensor"/>
  <rdfs:comment rdf:datatype="http://www.w3.org/2001/XMLSchema#string">A passive visual sensor capturing image-based information.</rdfs:comment>
</owl:Class>

<owl:Class rdf:about="#DepthCamera">
  <rdfs:subClassOf rdf:resource="#Active_Sensor"/>
  <rdfs:subClassOf rdf:resource="#Exteroceptor_Sensor"/>
  <rdfs:subClassOf rdf:resource="#IdentificationSensor"/>
  <rdfs:subClassOf rdf:resource="#Position_Sensor"/>
  <rdfs:comment rdf:datatype="http://www.w3.org/2001/XMLSchema#string">A camera-like sensor that actively acquires depth information.</rdfs:comment>
</owl:Class>

<owl:Class rdf:about="#LiDAR">
  <rdfs:subClassOf rdf:resource="#Active_Sensor"/>
  <rdfs:subClassOf rdf:resource="#Exteroceptor_Sensor"/>
  <rdfs:subClassOf rdf:resource="#IdentificationSensor"/>
  <rdfs:comment rdf:datatype="http://www.w3.org/2001/XMLSchema#string">A laser-based active sensor used for ranging and scene measurement.</rdfs:comment>
</owl:Class>

<owl:Class rdf:about="#RPLIDAR_A2">
  <rdfs:subClassOf rdf:resource="#LiDAR"/>
  <rdfs:comment rdf:datatype="http://www.w3.org/2001/XMLSchema#string">A specific LiDAR model represented as a subclass of LiDAR.</rdfs:comment>
</owl:Class>

<owl:Class rdf:about="#Radar">
  <rdfs:subClassOf rdf:resource="#Active_Sensor"/>
